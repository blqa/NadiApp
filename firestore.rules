// Reglas de Firestore de TODO NadiApp (proyecto nadiapp-b44ae).
//
// Cópialo completo y pégalo en Firebase → Firestore Database → Reglas → Publicar.
// Solo pueden entrar las dos cuentas de la puerta de NadiApp (sesion.js).
// Esos correos son de mentira (solo sirven de usuario), por eso pueden ir aquí.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo pasan Nadia y Luis, con sesión iniciada
    function esDeLosDos() {
      return request.auth != null
        && request.auth.token.email in ['nadia@godsplan.site', 'luis@godsplan.site'];
    }
    function esMio(uid) {
      return esDeLosDos() && request.auth.uid == uid;
    }

    // ===================== Apps de NadiApp =====================

    // LuNad y Mis Películas: lo de cada quien (ciclos, registros, calificaciones)
    match /artifacts/{app}/users/{uid}/{resto=**} {
      allow read, write: if esMio(uid);
    }

    // FinaNad (finanzas compartidas) y calificaciones de la comunidad de Películas
    match /artifacts/{app}/public/data/{resto=**} {
      allow read, write: if esDeLosDos();
    }

    // ===================== Nadia y Luis =====================

    // Quién es quién (ya no se usa, se deja por compatibilidad)
    match /usuarios/{uid} {
      allow read: if esDeLosDos();
      allow write: if esMio(uid);
    }

    // Buzón de notas
    match /buzon/{id} {
      allow read: if esDeLosDos();
      allow create: if esDeLosDos()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 1500;
      allow delete: if esDeLosDos() && resource.data.uid == request.auth.uid;
    }

    // “Estoy pensando en ti”
    match /pienso/{uid} {
      allow read: if esDeLosDos();
      allow write: if esMio(uid);
    }

    // Respuestas de la pregunta del día (el id es  AAAA-MM-DD_uid)
    match /respuestas/{id} {
      allow read: if esDeLosDos();
      allow create, update: if esDeLosDos()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 1200;
      allow delete: if esDeLosDos() && resource.data.uid == request.auth.uid;
    }

    // Sueños compartidos
    match /compartido/suenos {
      allow read, write: if esDeLosDos();
    }

    // Canciones dedicadas: las ven los dos, solo Luis las agrega o quita
    match /compartido/dedicadas {
      allow read: if esDeLosDos();
      allow write: if esDeLosDos() && request.auth.token.email == 'luis@godsplan.site';
    }

    // ===================== Granjita =====================
    // granjita/estado, granjita/mascota y sus subcolecciones
    // (parcelas, cofre, encargos, jugadores): los dos juegan juntos
    match /granjita/{resto=**} {
      allow read, write: if esDeLosDos();
    }

    // Todo lo demás, cerrado
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
